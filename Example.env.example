# ตัวอย่าง .env.example — แทนที่ค่าด้วยค่าจริงของคุณ

# Hugging Face API Token for Qwen 2.5-VL
HF_TOKEN=hf_your_huggingface_token_here

# NVIDIA API Key for Llama 3.1 Nemotron Ultra (Form Validation)
NVIDIA_API_KEY=nvapi_your_nvidia_api_key_here

# Supabase Configuration (Optional - for production use)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# External Forecast Service (runs Python models)
FORECAST_SERVICE_URL=https://your-forecast-service.example.com
NEXT_PUBLIC_FORECAST_SERVICE_URL=https://your-forecast-service.example.com
# FORECAST_SERVICE_TOKEN=your_forecast_service_token_if_needed
